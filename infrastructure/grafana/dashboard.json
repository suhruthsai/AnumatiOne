      "title": "Adversarial Path Optimizer Monte Carlo Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(approvalos_simulation_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (ms)"
        }
      ]
    }
